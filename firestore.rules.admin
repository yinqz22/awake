rules_version = '2';
// ============================================================================
//  awake – STRICT rules (roles, bans, kicks, private data)
//  Publish these ONLY after the migration check in README ("Admin-System"). To go back: publish firestore.rules.
//  Identity: every login is a Firebase Auth account <name>@awake.app. The role lives in authz/<uid>
//  (member | admin | owner). Nobody can write role "owner" from the app – the owner is set once in the console.
// ============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function authed() { return request.auth != null; }
    function azPath() { return /databases/$(database)/documents/authz/$(request.auth.uid); }
    function hasAz()  { return authed() && exists(azPath()); }
    function az()     { return get(azPath()).data; }
    // a "kick" stores a server time; tokens issued by a sign-in BEFORE that time stop working
    function kickOk() { return request.auth.token.get('auth_time', 9999999999) * 1000 >= az().get('kickedAt', timestamp.date(1970, 1, 1)).toMillis(); }
    function live()   { return hasAz() && az().get('banned', false) != true && kickOk(); }
    function role()   { return az().get('role', 'member'); }
    function isAdmin(){ return live() && role() in ['admin', 'owner']; }
    function isOwner(){ return live() && role() == 'owner'; }
    function myId()   { return az().id; }
    function isMe(id) { return live() && myId() == id; }
    function ownHandle(id) { return authed() && request.auth.token.email == id + '@awake.app'; }
    function uidOf(id) { return exists(/databases/$(database)/documents/users/$(id)) ? get(/databases/$(database)/documents/users/$(id)).data.get('uid', '') : ''; }
    function roleOf(id) {
      return uidOf(id) != '' && exists(/databases/$(database)/documents/authz/$(uidOf(id)))
        ? get(/databases/$(database)/documents/authz/$(uidOf(id))).data.get('role', 'member') : 'member';
    }
    // owner may manage admins + members, admins only members, nobody manages the owner
    function canManage(id) { return isOwner() ? roleOf(id) != 'owner' : (isAdmin() && roleOf(id) == 'member'); }

    // ---------- roles / ban / kick ----------
    match /authz/{uid} {
      allow get: if authed() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      // first login: a normal member record, bound to the caller's own login and profile. Role can only be "member".
      allow create: if authed() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['id', 'name', 'role', 'banned', 'joinedAt'])
        && request.resource.data.role == 'member' && request.resource.data.banned == false
        && ownHandle(request.resource.data.id)
        && get(/databases/$(database)/documents/users/$(request.resource.data.id)).data.get('uid', '') == request.auth.uid;
      allow update: if
        // owner: promote / demote / ban / kick – never the owner, never itself, only to member|admin
        ( isOwner() && uid != request.auth.uid && resource.data.role != 'owner'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'banned', 'banReason', 'kickedAt'])
          && request.resource.data.role in ['member', 'admin'] )
        ||
        // admin: ban / unban / kick members only – no role changes
        ( isAdmin() && uid != request.auth.uid && resource.data.role == 'member'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['banned', 'banReason', 'kickedAt']) );
      allow delete: if
        ( live() && request.auth.uid == uid && resource.data.role != 'owner' )                     // deleting your own account
        || ( isAdmin() && uid != request.auth.uid && ( (isOwner() && resource.data.role != 'owner') || resource.data.role == 'member' ) );
    }

    // ---------- 22-character public IDs: admins only ----------
    match /adminmeta/{id} {
      allow get, list: if isAdmin();
      allow create: if (isAdmin() || isMe(id))
        && request.resource.data.keys().hasOnly(['publicId', 'createdAt'])
        && request.resource.data.publicId.matches('[A-Za-z0-9]{22}')
        && exists(/databases/$(database)/documents/pubids/$(request.resource.data.publicId))
        && get(/databases/$(database)/documents/pubids/$(request.resource.data.publicId)).data.id == id;
      allow delete: if isMe(id) || (isAdmin() && canManage(id));
    }
    match /pubids/{pid} {
      allow get, list: if isAdmin();
      allow create: if pid.matches('[A-Za-z0-9]{22}') && request.resource.data.keys().hasOnly(['id'])
        && ( isAdmin() || ( isMe(request.resource.data.id) && !exists(/databases/$(database)/documents/adminmeta/$(request.resource.data.id)) ) );
      allow delete: if (live() && resource.data.id == myId()) || (isAdmin() && canManage(resource.data.id));
    }

    // ---------- last activity ----------
    match /activity/{id} {
      allow get, list: if isAdmin();
      allow create, update: if isMe(id) && request.resource.data.keys().hasOnly(['lastActive']) && request.resource.data.lastActive == request.time;
      allow delete: if isMe(id) || (isAdmin() && canManage(id));
    }

    // ---------- private per-user data (list of session ids = access keys) ----------
    match /private/{id} {
      allow get: if isMe(id) || isAdmin();
      allow create, update: if isMe(id) && request.resource.data.keys().hasOnly(['sessions']);
      allow delete: if isMe(id) || (isAdmin() && canManage(id));
    }

    // ---------- profile + friend lists ----------
    match /users/{id} {
      allow get: if live() || ownHandle(id);
      allow list: if isAdmin();
      allow create: if ownHandle(id) && request.resource.data.get('uid', '') == request.auth.uid;
      allow update: if
        // your own profile (the login binding "uid" can never change)
        ( isMe(id) && resource.data.get('uid', '') == request.auth.uid && request.resource.data.get('uid', '') == request.auth.uid )
        // friend requests: other signed-in users may only touch the three friend lists
        || ( live() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['friends', 'incoming', 'outgoing']) )
        // first login of an account from before the secure login: proves the old password hash (or an admin-approved reset)
        || ( ownHandle(id) && !('uid' in resource.data) && request.resource.data.uid == request.auth.uid
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid', 'claimProof'])
             && ( ('passHash' in resource.data && request.resource.data.claimProof == resource.data.passHash) || resource.data.get('resetOk', false) == true ) )
        // admin: allow a password reset (after the login was deleted in the console)
        || ( isAdmin() && canManage(id) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid', 'resetOk']) );
      allow delete: if ( isMe(id) && role() != 'owner' ) || ( isAdmin() && canManage(id) );
    }

    // ---------- reselling sessions (access = knowing the secret session id) + workout data (owner only) ----------
    match /sessions/{sid} {
      function isFit()    { return sid.matches('fit_.*') || sid.matches('fitlog_.*'); }
      function fitId()    { return sid.matches('fit_.*') ? sid[4:] : sid[7:sid.size() - 8]; }
      function fitOwner() { return live() && ( sid == 'fit_' + myId() || sid.matches('fitlog_' + myId() + '_[0-9]{4}-[0-9]{2}') ); }
      allow get: if isAdmin() || ( live() && ( !isFit() || fitOwner() ) );
      allow list: if false;
      allow create, update: if live() && ( !isFit() || fitOwner() );
      allow delete: if ( live() && ( !isFit() || fitOwner() ) ) || ( isAdmin() && isFit() && canManage(fitId()) );
    }
  }
}
